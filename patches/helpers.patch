+
+double C2ExplorationManager::methodExecutionRisk(
+    const int frontier_id, const Vector3d& goal) const {
+  if (!methodReachActive() && !methodSteerActive()) return 0.0;
+  if (frontier_id < 0) return 0.0;
+  const std::string key = prctCooldownKey(frontier_id, goal, currentMapVersion());
+  int repeat = 0;
+  const auto it = prct_cooldowns_.find(key);
+  if (it != prct_cooldowns_.end()) repeat = it->second.repeat_count;
+  const auto fit = prct_frontier_cooldowns_.find(frontier_id);
+  if (fit != prct_frontier_cooldowns_.end()) {
+    repeat = std::max(repeat, fit->second.repeat_count);
+  }
+  if (repeat <= 0) return 0.0;
+  const double rho = std::min(1.0, static_cast<double>(repeat) / 6.0);
+  return rho;
+}
+
+double C2ExplorationManager::methodSteerCandidateScore(
+    const Vector3d& reference, const int frontier_id, const Vector3d& goal) const {
+  vector<Eigen::Vector3d> path;
+  const double nominal = ViewNode::computeCost(
+      reference, goal, 0, 0, Eigen::Vector3d(0, 0, 0), 0, path);
+  if (ViewNode::isUnreachableCost(nominal)) {
+    return std::numeric_limits<double>::max();
+  }
+  const double risk = methodExecutionRisk(frontier_id, goal);
+  double load = 0.0;
+  if (ed_ && ep_ && ep_->drone_id_ > 0 &&
+      ep_->drone_id_ <= static_cast<int>(ed_->swarm_state_.size())) {
+    load = static_cast<double>(
+        ed_->swarm_state_[ep_->drone_id_ - 1].center_positions_.size());
+  }
+  return nominal * (1.0 + steer_load_bias_ * load + reach_risk_weight_ * risk) +
+         reach_risk_penalty_ * risk;
+}
